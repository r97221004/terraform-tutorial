# Copy to terraform.tfvars (git-ignored) and edit:
#   cp terraform.tfvars.example terraform.tfvars

environment = "dev"
team        = "ml-platform"

serving = {
  replicas   = 2
  max_tokens = 8192
  # name_suffix and gpu_type are left out: their optional() defaults apply.
}

extra_labels = {
  cost-center = "research"
}
