# Copy to terraform.tfvars (git-ignored), then edit it at each rollout step:
#   cp terraform.tfvars.example terraform.tfvars

# Step 0: give the running version a name, and all the traffic.
revision = "hello-v1"
traffic = {
  "hello-v1" = 100
}

# Step 1: a new revision with no traffic yet, only its tag URL:
#   revision = "hello-v2"
#   message  = "Hello again"
#   traffic  = { "hello-v1" = 100, "hello-v2" = 0 }
#
# Step 2: traffic = { "hello-v1" = 90, "hello-v2" = 10 }
# Step 3: traffic = { "hello-v2" = 100 }
